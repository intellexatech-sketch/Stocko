# ===================================================================
# Stocko Wholesale - Gmail SMTP Configuration
# ===================================================================

# Gmail address used to authenticate and send contact emails
GMAIL_USER=chidanandh39@gmail.com

# Google Account App Password (16 characters, no spaces)
# To create an App Password:
# 1. Go to your Google Account -> Security (https://myaccount.google.com/security)
# 2. Make sure 2-Step Verification is turned ON.
# 3. Search for "App Passwords" or go to https://myaccount.google.com/apppasswords
# 4. Create an app password named "Stocko Wholesale" and paste the 16-character code below:
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Recipient address where customer contact emails will be delivered (defaults to stockowholesale@gmail.com)
CONTACT_RECEIVER_EMAIL=stockowholesale@gmail.com

# Optional SMTP Settings (defaults are already configured for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

